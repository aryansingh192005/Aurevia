# Copy to .env.docker and replace every placeholder before starting the stack.
AUREVIA_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
AUREVIA_THERAPIST_REGISTRATION_CODE=REPLACE_WITH_A_DIFFERENT_RANDOM_INVITATION_CODE
AUREVIA_HTTP_PORT=8080
MYSQL_DATABASE=aurevia
MYSQL_USER=aurevia
MYSQL_PASSWORD=replace-with-a-long-alphanumeric-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-alphanumeric-password
