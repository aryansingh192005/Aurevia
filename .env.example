# Local development configuration. Copy to .env and replace the secret.

AUREVIA_ENV=development
AUREVIA_SECRET_KEY=replace-with-a-long-random-secret
AUREVIA_THERAPIST_REGISTRATION_CODE=

# Optional. If omitted, local development uses instance/aurevia.db (SQLite).
# MySQL example: mysql+pymysql://aurevia:password@127.0.0.1:3306/aurevia
AUREVIA_DATABASE_URL=

FLASK_ENV=development
