reports/generated/


# ============================================================
# DO NOT IGNORE AUREVIA SOURCE CODE
# ============================================================
# ai/
# backend/
# frontend/
# tests/
#
# These directories intentionally remain TRACKED.
# Their internal caches/artifacts are ignored by the rules above.