# ============================================================
# AUREVIA
# AI-Powered Rehabilitation Platform
# Root Git Ignore
# ============================================================


# ============================================================
# ENVIRONMENT VARIABLES & SECRETS
# ============================================================

.env
.env.*
!.env.example

*.pem
*.key
*.crt
*.p12
*.pfx


# ============================================================
# PYTHON
# ============================================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Python caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Backend virtual environment
backend/.venv/

# Jupyter
.ipynb_checkpoints/


# ============================================================
# NODE / REACT / VITE
# ============================================================

# Dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
frontend/dist/
build/
frontend/build/

# Vite
.vite/
frontend/.vite/

# npm logs
npm-debug.log*
npm-error.log*

# Yarn logs
yarn-debug.log*
yarn-error.log*
yarn-error.log

# pnpm logs
pnpm-debug.log*

# Package manager caches
.npm/
.yarn/
.pnpm-store/


# ============================================================
# JAVASCRIPT / TYPESCRIPT
# ============================================================

# TypeScript build information
*.tsbuildinfo

# ESLint cache
.eslintcache

# Stylelint cache
.stylelintcache


