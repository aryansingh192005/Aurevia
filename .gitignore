checkpoint/
saved_model/
logs/

# Experiment outputs
runs/
wandb/
mlruns/

# Generated predictions / outputs
predictions/
outputs/
results/


# ============================================================
# DATA / DATABASE LOCAL ARTIFACTS
# ============================================================

# Local database files
*.db
*.sqlite
*.sqlite3

# Local database dumps
*.sql.gz

# Temporary datasets
*.tmp
*.temp


# ============================================================
# LOGS
# ============================================================

*.log
logs/


# ============================================================
