# ============================================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory


# ============================================================
# TEMPORARY / BACKUP FILES
# ============================================================

*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# Temporary folders
tmp/
temp/


# ============================================================
# TEST / DEVELOPMENT ARTIFACTS
# ============================================================

test-results/
playwright-report/
blob-report/
.nyc_output/


# ============================================================
